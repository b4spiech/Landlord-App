DATABASE_URL=postgresql+psycopg://pm_user:pm_pass@localhost:5432/property_mgmt
PORT=8000
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8000

# AI lease document parsing (Claude). Without this, parsing is disabled and the
# UI falls back to manual entry.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# DocuSign e-signature (JWT / server-to-server). Without these, "Send for
# Signature" returns a clear "not configured" message.
DOCUSIGN_ACCOUNT_ID=your-account-id
DOCUSIGN_INTEGRATION_KEY=your-integration-key
DOCUSIGN_USER_ID=your-impersonated-user-guid
DOCUSIGN_PRIVATE_KEY=
DOCUSIGN_OAUTH_HOST=account-d.docusign.com
DOCUSIGN_BASE_URL=https://demo.docusign.net/restapi
DOCUSIGN_WEBHOOK_SECRET=webhook-secret

# Cloudflare Email Service (SMTP). Password = Cloudflare API token with Email Sending: Write.
SMTP_HOST=smtp.mx.cloudflare.net
SMTP_PORT=465
SMTP_USER=api_token
SMTP_PASSWORD=
SMTP_FROM=tours@apexelementgrp.com
SMTP_FROM_NAME=APEX Element Group
SMTP_REPLY_TO=

# Landlord app protection. When true, landlord APIs require a valid Cloudflare
# Access JWT (blocks direct-to-Railway access). AUD = the landlord Access app's
# Application Audience tag.
CLOUDFLARE_ACCESS_ENABLED=false
CF_ACCESS_TEAM_DOMAIN=noisy-bread-d22c.cloudflareaccess.com
CF_ACCESS_AUD=
CF_ACCESS_ALLOWED_EMAILS=

# Hostnames that serve only the public tour site (landlord APIs 404 there).
PUBLIC_HOSTS=apexelementgrp.com,www.apexelementgrp.com,tours.apexelementgrp.com
PUBLIC_SITE_URL=https://tours.apexelementgrp.com

# Tour-request notifications. Email defaults to the first CF_ACCESS_ALLOWED_EMAILS.
LANDLORD_APP_URL=https://dev-app.apexelementgrp.com
LANDLORD_NOTIFY_EMAIL=

# SMS (Twilio). Unset = texts are skipped (and logged).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
LANDLORD_SMS_NUMBER=
